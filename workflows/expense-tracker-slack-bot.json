    {
      "parameters": {
        "source": "database",
        "workflowId": {"__rl": true, "mode": "id", "value": "Hih5XlwiqCn2yITU", "cachedResultName": "Expense Tracker – Read Balances"},
        "workflowInputs": {"schema": [], "mappingMode": "autoMapInputData", "value": {}}
      },
      "id": "fetch-balances",
      "name": "Fetch Balances",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [608, -80]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst MEMBERS = ['Diana', 'Jasmine', 'Simmy'];\nconst firstKey = Object.keys(rows[0] || {}).find(k => k !== 'row_number');\nif (!firstKey) return [{json: {output: 'No balance data.'}}];\nconst memberRows = rows.filter(r => MEMBERS.includes(r[firstKey]) && r['col_5']);\nconst fromIdx = rows.findIndex(r => r[firstKey] === 'From');\nconst settleRows = fromIdx >= 0\n  ? rows.slice(fromIdx + 1).filter(r => r[firstKey] && r['col_2'] && r['col_3'])\n  : [];\nif (!memberRows.length) return [{json: {output: 'Could not parse balance data.'}}];\nconst lines = ['💰 *Current Balances*', ''];\nfor (const row of memberRows) {\n  const name = row[firstKey];\n  const net = parseFloat(row['col_4'] || '0');\n  const status = row['col_5'];\n  const emoji = net >= 0 ? '🟢' : '🔴';\n  lines.push(`${emoji} *${name}*: ${status}`);\n}\nif (settleRows.length) {\n  lines.push('', '📋 *To settle up:*');\n  for (const row of settleRows) {\n    const amt = parseFloat(row['col_3']);\n    lines.push(`• ${row[firstKey]} → ${row['col_2']}: $${amt.toFixed(2)}`);\n  }\n}\nreturn [{json: {output: lines.join('\\n')}}];"
      },
      "id": "format-balances",
      "name": "Format Balances",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [912, -80]
    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "={{ $json.text || $json.chatInput || $json.body.text }}",
        "options": {
          "systemMessage": "You are an expense-tracking assistant for a group trip. You manage a Google Sheet with shared expenses for Diana, Jasmine, and Simmy.\n\nSHEET COLUMNS (Expenses tab):\n- ID: sequential integer (new row = max existing ID + 1)\n- Date: YYYY-MM-DD\n- Description: free text\n- Category: Food & Drink | Gas / Fuel | Transportation | Lodging | Entertainment | Groceries | Shopping | Other\n- Currency: always USD\n- Total: full expense amount\n- Split Type: Equal | Custom\n- Paid: Diana / Paid: Jasmine / Paid: Simmy (must sum to Total)\n- Owed: Diana / Owed: Jasmine / Owed: Simmy (must sum to Total)\n- Notes: optional\nDO NOT write Check Paid or Check Owed — those are auto-formulas.\n\nSPLIT RULES:\n- Equal: each Owed = Total / 3, rounded to cents; distribute any leftover penny so the three values sum exactly to Total.\n- Custom: set Split Type = Custom, set Owed cells individually, add a Note.\n\nTOOL USAGE:\n- read_balances: use for ANY balance, reconciliation, or settle-up question. Reads pre-calculated results — do NOT compute manually.\n- read_expenses: use for listing expenses, searching specific entries, or before adding/updating a row.\n- append_expense: call with a JSON object of all writable columns to add a new row.\n- update_expense: call with a JSON object containing ID plus the fields you want to change.\n\nKeep replies concise and WhatsApp/Slack-friendly. Format amounts as $X.XX."
        }
      },
