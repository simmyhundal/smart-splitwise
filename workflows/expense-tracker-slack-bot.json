    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst event = body.event || {};\nconst result = {\n  text: event.text || '',\n  user: event.user || '',\n  channel: event.channel || ''\n};\n// Only set bot_id if it actually exists — Skip Bot Messages uses notExists to filter bots\nif (event.bot_id) result.bot_id = event.bot_id;\nreturn [{json: result}];"
      },
      "id": "slack-extract",
      "name": "Extract Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}",
        "options": {"responseCode": 200}
      },
      "id": "slack-ack",
      "name": "Ack Slack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 600]
    },
    {
      "parameters": {
        "jsCode": "const eventId = $json.event_id;\nif (!eventId) return [$input.first()];\n\nconst store = $getWorkflowStaticData('global');\nif (!store.processedEvents) store.processedEvents = {};\n\n// Already seen this event_id — Slack retry, skip it\nif (store.processedEvents[eventId]) {\n  return [];\n}\n\n// Mark as processed, keep last 200 events\nstore.processedEvents[eventId] = Date.now();\nconst keys = Object.keys(store.processedEvents);\nif (keys.length > 200) {\n  const oldest = keys.sort((a,b) => store.processedEvents[a] - store.processedEvents[b]).slice(0, keys.length - 200);\n  oldest.forEach(k => delete store.processedEvents[k]);\n}\n\nreturn [$input.first()];"
      },
      "id": "dedup-check",
      "name": "Dedup Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 600]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "loose"},
          "conditions": [{"id": "balance-intent", "leftValue": "={{ ($json.text || $json.body?.text || $json.chatInput || '').toLowerCase() }}", "operator": {"type": "string", "operation": "regex"}, "rightValue": "balance|who owes|reconcil|settle|bilan|qui doit|net|owe"}],
          "combinator": "and"
        },
        "options": {}
      },
